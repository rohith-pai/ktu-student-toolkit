# Copy this file to ".env" in the project root and fill in your values.
# The app loads .env automatically at startup.

# Supabase JDBC settings (optional - only needed for WITH JDBC mode)
DB_URL=jdbc:postgresql://aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your_database_password

ETLAB_USERNAME=your_etlab_username
ETLAB_PASSWORD=your_etlab_password
ETLAB_SESSION_TOKEN=
